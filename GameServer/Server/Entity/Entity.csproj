<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    <RootNamespace>Entity</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Fantasy-Net" Version="2026.1.2002" />
    <PackageReference Include="NLog" Version="6.2.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
    <PackageReference Include="ToolGood.Words" Version="3.1.0.3" />
  </ItemGroup>

  <!-- Fantasy.NLog 从输出目录读取 NLog.config，缺失时启动即空引用崩溃 -->
  <ItemGroup>
    <None Update="NLog.config" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 前后端共享的确定性战斗逻辑：源码在 Unity 工程里，服务端直接引用同一份文件编译 -->
  <PropertyGroup>
    <UnityAssetsDir>..\..\..\GameUnity\Assets\</UnityAssetsDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(UnityAssetsDir)DGame\FixedPoint\**\*.cs"
             Exclude="$(UnityAssetsDir)DGame\FixedPoint\Physics\Samples\**;$(UnityAssetsDir)DGame\FixedPoint\**\*.Unity.cs"
             Link="Shared\FixedPoint\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="$(UnityAssetsDir)Scripts\HotFix\GameBattle\**\*.cs"
             Link="Shared\GameBattle\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>